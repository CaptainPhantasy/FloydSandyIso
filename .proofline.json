{
  "version": 1,
  "gates": [
    {
      "name": "go-tests",
      "command": ["go", "test", "./...", "-count=1"],
      "required": true
    },
    {
      "name": "go-vet",
      "command": ["go", "vet", "./..."],
      "required": true
    },
    {
      "name": "go-build",
      "command": ["go", "build", "./..."],
      "required": true
    }
  ],
  "include": [
    ".gitignore",
    ".proofline.json",
    "docs/RECOVERED_FEATURES.md",
    "floyd-schema.json",
    "internal/agent/agent.go",
    "internal/agent/context.go",
    "internal/agent/prompt/prompt.go",
    "internal/agent/summarizer.go",
    "internal/agent/templates/coder.md.tpl",
    "internal/agent/tools/context_status.go",
    "internal/config/config.go",
    "internal/config/load.go",
    "internal/config/load_test.go",
    "internal/db/migrations/20260305000000_add_tokens_summarized.sql",
    "internal/db/models.go",
    "internal/db/sessions.sql.go",
    "internal/db/sql/sessions.sql",
    "internal/message/content.go",
    "internal/plugins/plugins.go",
    "internal/plugins/plugins_test.go",
    "internal/session/session.go",
    "internal/ui/dialog/skills_library.go",
    "internal/ui/logo/logo.go",
    "internal/ui/model/header.go",
    "internal/ui/model/ui.go",
    "main.go"
  ],
  "deny": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    ".claude/**",
    ".floyd/**",
    ".planning/**",
    ".pi/**",
    ".supercache/**",
    "FLOYD.md",
    "HANDOFF.md",
    "Issues/**",
    "SSOT/**",
    "docs/exports/**",
    "pi-session-*.html"
  ],
  "secretFixtureAllowlist": [
    "internal/config/load_test.go"
  ],
  "baseBranch": "main",
  "publish": true,
  "allowLocalRemote": false
}
